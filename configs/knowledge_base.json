{
  "description": "База знаний экспертной оценки состояния дорожного покрытия по маске сегментации. Пороги — эвристические, задаются экспертом и могут меняться без правки кода. Факты в процентах — доля площади кадра.",
  "params": {
    "crack_minor_pct": 1.0,
    "crack_major_pct": 8.0,
    "pothole_large_pct": 2.5,
    "pothole_many": 3,
    "pothole_near_min_pct": 0.3,
    "near_zone_from": 0.6,
    "conf_min": 0.6
  },
  "param_descriptions": {
    "crack_minor_pct": "площадь трещин, % кадра, начиная с которой участок считается растрескавшимся",
    "crack_major_pct": "площадь трещин, % кадра, при которой нужен плановый ремонт",
    "pothole_large_pct": "площадь одной выбоины, % кадра, при которой она считается крупной",
    "pothole_many": "число выбоин в кадре, при котором участок считается аварийным",
    "pothole_near_min_pct": "мин. площадь выбоины в ближней зоне для предупреждения водителя, % кадра",
    "near_zone_from": "граница ближней зоны: доля высоты кадра сверху (0,6 — нижние 40 %)",
    "conf_min": "минимальная средняя уверенность модели по пикселям дефектов"
  },
  "severity_levels": {
    "0": {
      "name": "дефекты не обнаружены",
      "priority": "—"
    },
    "1": {
      "name": "хорошее",
      "priority": "низкий"
    },
    "2": {
      "name": "удовлетворительное",
      "priority": "плановый осмотр"
    },
    "3": {
      "name": "неудовлетворительное",
      "priority": "плановый ремонт"
    },
    "4": {
      "name": "аварийное",
      "priority": "срочный ремонт"
    }
  },
  "rules": [
    {
      "id": "D1",
      "name": "Наличие выбоин",
      "if": [
        [
          "pothole_count",
          ">",
          0
        ]
      ],
      "then": {
        "facts": {
          "has_pothole": true
        }
      }
    },
    {
      "id": "D2",
      "name": "Наличие зоны трещиноватости",
      "if": [
        [
          "crack_area_pct",
          ">=",
          "$crack_minor_pct"
        ]
      ],
      "then": {
        "facts": {
          "has_crack_zone": true
        }
      }
    },
    {
      "id": "D3",
      "name": "Прогрессирующее разрушение",
      "if": [
        [
          "has_pothole",
          "==",
          true
        ],
        [
          "has_crack_zone",
          "==",
          true
        ]
      ],
      "then": {
        "facts": {
          "progressive_damage": true
        },
        "message": "Выбоины расположены на участке с сеткой трещин — разрушение покрытия прогрессирует."
      }
    },
    {
      "id": "R0",
      "name": "Нет дефектов",
      "if": [
        [
          "pothole_count",
          "==",
          0
        ],
        [
          "crack_count",
          "==",
          0
        ]
      ],
      "then": {
        "severity": 0,
        "message": "Выбоины и трещины не обнаружены."
      }
    },
    {
      "id": "R1",
      "name": "Единичные мелкие трещины",
      "if": [
        [
          "has_pothole",
          "!=",
          true
        ],
        [
          "crack_count",
          ">",
          0
        ],
        [
          "crack_area_pct",
          "<",
          "$crack_minor_pct"
        ]
      ],
      "then": {
        "severity": 1,
        "message": "Обнаружены единичные трещины малой площади.",
        "recommendation": "Наблюдение при следующем плановом проезде."
      }
    },
    {
      "id": "R2",
      "name": "Зона трещиноватости средней площади",
      "if": [
        [
          "has_pothole",
          "!=",
          true
        ],
        [
          "crack_area_pct",
          ">=",
          "$crack_minor_pct"
        ],
        [
          "crack_area_pct",
          "<",
          "$crack_major_pct"
        ]
      ],
      "then": {
        "severity": 2,
        "message": "Покрытие на участке растрескалось.",
        "recommendation": "Герметизация (заливка) трещин, повторный осмотр."
      }
    },
    {
      "id": "R3",
      "name": "Обширная зона трещиноватости",
      "if": [
        [
          "crack_area_pct",
          ">=",
          "$crack_major_pct"
        ]
      ],
      "then": {
        "severity": 3,
        "message": "Трещины покрывают значительную часть кадра.",
        "recommendation": "Плановый ремонт покрытия участка (фрезерование, укладка слоя)."
      }
    },
    {
      "id": "R4",
      "name": "Выбоины умеренного размера",
      "if": [
        [
          "has_pothole",
          "==",
          true
        ],
        [
          "pothole_max_pct",
          "<",
          "$pothole_large_pct"
        ],
        [
          "pothole_count",
          "<",
          "$pothole_many"
        ]
      ],
      "then": {
        "severity": 3,
        "message": "Обнаружены выбоины.",
        "recommendation": "Ямочный ремонт в плановом порядке."
      }
    },
    {
      "id": "R5",
      "name": "Крупная выбоина",
      "if": [
        [
          "pothole_max_pct",
          ">=",
          "$pothole_large_pct"
        ]
      ],
      "then": {
        "severity": 4,
        "message": "Обнаружена крупная выбоина.",
        "recommendation": "Срочный ямочный ремонт; до устранения — ограждение и временные знаки."
      }
    },
    {
      "id": "R6",
      "name": "Множественные выбоины",
      "if": [
        [
          "pothole_count",
          ">=",
          "$pothole_many"
        ]
      ],
      "then": {
        "severity": 4,
        "message": "Обнаружено много выбоин на одном участке.",
        "recommendation": "Срочный ремонт участка."
      }
    },
    {
      "id": "R7",
      "name": "Выбоины на участке с сеткой трещин",
      "if": [
        [
          "progressive_damage",
          "==",
          true
        ]
      ],
      "then": {
        "severity": 3,
        "recommendation": "Ремонтировать участок целиком, а не только отдельные выбоины."
      }
    },
    {
      "id": "R7a",
      "name": "Выбоины на обширной зоне трещин",
      "if": [
        [
          "progressive_damage",
          "==",
          true
        ],
        [
          "crack_area_pct",
          ">=",
          "$crack_major_pct"
        ]
      ],
      "then": {
        "severity": 4,
        "message": "Выбоины на обширной зоне трещиноватости — покрытие разрушено.",
        "recommendation": "Срочный ремонт участка."
      }
    },
    {
      "id": "R8",
      "name": "Выбоина непосредственно перед ТС",
      "if": [
        [
          "pothole_near_max_pct",
          ">=",
          "$pothole_near_min_pct"
        ]
      ],
      "then": {
        "facts": {
          "driver_warning": true
        },
        "message": "Выбоина в ближней зоне перед автомобилем — предупреждение водителю."
      }
    },
    {
      "id": "R9",
      "name": "Люк — не дефект",
      "if": [
        [
          "manhole_count",
          ">",
          0
        ]
      ],
      "then": {
        "message": "Обнаружен люк: не является дефектом, учитывается как элемент обустройства.",
        "recommendation": "Проверить отсутствие просадки покрытия вокруг люка."
      }
    },
    {
      "id": "R10",
      "name": "Низкая уверенность модели",
      "if": [
        [
          "mean_conf",
          "<",
          "$conf_min"
        ],
        [
          "defect_area_pct",
          ">",
          0
        ]
      ],
      "then": {
        "facts": {
          "needs_review": true
        },
        "message": "Уверенность модели низкая — результат нужно проверить оператору."
      }
    }
  ]
}